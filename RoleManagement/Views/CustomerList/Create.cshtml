@model RoleManagement.ViewModels.CustomerListViewModel

@{
    ViewData["Title"] = Model?.CustomerId == 0 ? "Add Customer" : "Edit Customer";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="@(ViewData["Title"].ToString().Contains("Edit") ? "Edit" : "Create")">

    @Html.HiddenFor(model => model.CustomerId)

    <div class="form-group">
        <label asp-for="CustomerName"></label>
        <input asp-for="CustomerName" class="form-control" />
        <span asp-validation-for="CustomerName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ProductName"></label>
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Amount"></label>
        <input type="number" asp-for="Amount" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, ''); "/>
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-2">Save</button>

</form>

