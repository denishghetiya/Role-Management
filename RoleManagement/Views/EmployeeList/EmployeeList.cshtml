@model RoleManagement.ViewModels.EmployeeListPageViewModel

@{
    ViewData["Title"] = "Employee List";
}

<button onclick="Dashboard()" class="btn btn-success mb-3">Go to Dashboard</button>

<h2>Employee List</h2>

@if (Model.Add)
{
    <a style="float: right;" class="btn btn-primary mb-3" asp-action="Create">Add New Employee</a>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Employee Name</th>
            <th>Department Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model.Employees)
        {
            <tr>
                <td>@employee.EmployeeName</td>
                <td>@employee.DepartmentName</td>
                <td>
                    @if (Model.Edit)
                    {
                        <a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@employee.EmployeeId">Edit</a>
                    }
                    @if (Model.Delete)
                    {
                        <button onclick="DeleteEmployee(@employee.EmployeeId)" class="btn btn-sm btn-danger">Delete</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<script src="~/js/site.js"></script>