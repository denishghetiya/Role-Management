@model RoleManagement.ViewModels.StudentListViewModel

@{
    ViewData["Title"] = Model?.StudentId == 0 ? "Add Student" : "Edit Student";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="@(ViewData["Title"].ToString().Contains("Edit") ? "Edit" : "Create")">

    @Html.HiddenFor(model => model.StudentId)

    <div class="form-group">
        <label asp-for="StudentName"></label>
        <input asp-for="StudentName" class="form-control" />
        <span asp-validation-for="StudentName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="RollNumber"></label>
        <input asp-for="RollNumber" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, ''); "/>
        <span asp-validation-for="RollNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Class"></label>
        <input asp-for="Class" class="form-control" />
        <span asp-validation-for="Class" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-2">Save</button>

</form>

<button onclick="StudentList()" class="btn btn-secondary mt-2">Cancel</button>

<script src="~/js/site.js"></script>