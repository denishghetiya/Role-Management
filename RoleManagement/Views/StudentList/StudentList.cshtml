@model RoleManagement.ViewModels.StudentListPageViewModel

@{
    ViewData["Title"] = "Student List";
}

<button onclick="Dashboard()" class="btn btn-success mb-3">Go to Dashboard</button>

<h2>Student List</h2>

@if (Model.Add)
{
    <a style="float: right;" class="btn btn-primary mb-3" asp-action="Create">Add New Student</a>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>Roll Number</th>
            <th>Class</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model.Students)
        {
            <tr>
                <td>@student.StudentName</td>
                <td>@student.RollNumber</td>
                <td>@student.Class</td>
                <td>
                    @if (Model.Edit)
                    {
                        <a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@student.StudentId">Edit</a>
                    }
                    @if (Model.Delete)
                    {
                        <button onclick="DeleteStudent(@student.StudentId)" class="btn btn-sm btn-danger">Delete</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<script src="~/js/site.js"></script>